pipeline {
    agent any

    tools {
        terraform 'Terraform-test'
    }

    environment {
        GIT_URL    = "https://github.com/wallmore/terraform.git"
        GIT_BRANCH = "main"
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_URL}"
            }
        }
        ...
    }
}
